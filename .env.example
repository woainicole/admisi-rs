# Konfigurasi Firebase (config web, bukan rahasia)
# Salin file ini menjadi .env.local lalu isi nilainya dari Firebase Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Integrasi seamless ke NutriSmart (isi dari .env.local NutriSmart)
VITE_NUTRISMART_SUPABASE_URL=
VITE_NUTRISMART_SUPABASE_ANON_KEY=
